filter(access >= 20) |>
count(year)
library(tidyverse)
library(tidyverse)
trips <- tibble(
station = rep(c("Riverside", "Old Town", "University"), each = 3),
day     = rep(c("Mon", "Tue", "Wed"), times = 3),
rain    = rep(c(FALSE, TRUE, FALSE), times = 3),
rides   = c(120, 60, 140, 90, 70, 100, 150, 40, 170)
)
trips
trips_dry     <- filter(trips, rain == FALSE)
trips_grouped <- group_by(trips_dry, station)
trips_summary <- summarise(trips_grouped, mean_rides = mean(rides))
trips_sorted  <- arrange(trips_summary, desc(mean_rides))
trips_sorted
arrange(summarise(group_by(filter(trips, rain == FALSE), station), mean_rides = mean(rides)), desc(mean_rides))
