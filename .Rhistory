print(counter)
}
heads_in_row <- 0                      # set OUTSIDE the loop
while (heads_in_row < 3) {             # condition checked each time
flip <- sample(c("H", "T"), 1)
if (flip == "H") {
heads_in_row <- heads_in_row + 1   # updated INSIDE the loop
} else {
heads_in_row <- 0                  # reset on tails
}
}
heads_in_row <- 4                      # set OUTSIDE the loop
while (heads_in_row < 3) {             # condition checked each time
flip <- sample(c("H", "T"), 1)
if (flip == "H") {
heads_in_row <- heads_in_row + 1   # updated INSIDE the loop
} else {
heads_in_row <- 0                  # reset on tails
}
}
my_sum <- function(vector) {
# special case: empty vector
if (length(vector) == 0) {
return(0)    # nothing to add, so exit early
} else {
# compute the sum
total <- 0
for (i in seq_along(vector)) {
total <- total + vector[i]
}
return(total)
}
}
my_sum(c(2, 1, 5, 2))
my_sum(c())
