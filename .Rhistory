library(palmerpenguins)
library(purrr)
map_int(penguins, \(x) sum(is.na(x)))
library(dplyr)
penguins |>
group_by(species) |>
sapply(penguins, \(x) sum(is.na(x)))                              # base R: named vector
map_int(penguins, \(x) sum(is.na(x)))                             # purrr: named integer vector
penguins |> summarise(across(everything(), \(x) sum(is.na(x))))
