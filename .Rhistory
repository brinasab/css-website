library(tidyverse)
internet <- tibble(
country = c("Kenya", "India", "Brazil"),
`2010`  = c(7, 8, 42),
`2015`  = c(17, 20, 59),
`2020`  = c(29, 41, 80)
)
internet
internet |>
summarize(mean_2010 = mean(`2010`),
mean_2015 = mean(`2015`),
mean_2020 = mean(`2020`))
internet_tidy <- internet |>
pivot_longer(cols = -country,
names_to = "year",
values_to = "access") |>
mutate(year = as.integer(year))
internet_tidy
internet_tidy |>
group_by(year) |>
summarize(mean_access = mean(access, na.rm = TRUE))
internet_tidy |>
filter(access >= 20) |>
count(year)
