# correct answer
t2_q1 <- scdb_case %>%
group_by(term) %>%
summarize(avg_min_votes = mean(minVotes, na.rm = TRUE))
t2_q1
# optional to add
t2_q1 %>% slice_max(avg_min_votes, n = 3)
t2_q1 %>% slice_min(avg_min_votes, n = 3)
# we can accept other code/graphs as long as they correctly answer the question
# how many of Warren's votes have a missing direction
scdb_vote %>%
filter(justiceName == "EWarren") %>%
count(direction)
# correct answer
t2_q2 <- scdb_vote %>%
filter(justiceName == "EWarren") %>%
filter(!is.na(direction)) %>%
# for labels in plot, see recoding from above
mutate(direction_label = recode(direction,
`0` = "Conservative",
`1` = "Liberal",
.default = NA_character_)) %>%
group_by(direction_label) %>%
count()
t2_q2
# visualize results
ggplot(t2_q2, aes(x = direction_label,
y = n,
fill = direction_label)) +
geom_bar(stat = "identity") +  # [CLAUDE] geom_col() is the same, shorter
# [CLAUDE] fill repeats the x axis, so the legend is redundant; consider
# removing fill, or adding show.legend = FALSE
labs(
title = "Earl Warren: Voting Direction",
x = "Direction of Vote",
y = "Number of Votes",
fill = "Vote Direction"
)
# chief is already a factor in chronological order (Task 1), so group_by()
# and the x axis follow that order automatically;
# decisionDirection is 0/1 (1 = liberal), so its mean is the liberal share
t2_q3 <- scdb_case %>%
group_by(chief) %>%
summarize(
n_decisions = sum(!is.na(decisionDirection)),
pct_liberal = mean(decisionDirection, na.rm = TRUE))
t2_q3
ggplot(t2_q3, aes(x = chief, y = pct_liberal)) +
geom_bar(stat = "identity") +
scale_y_continuous(labels = scales::label_percent()) +
# rotate the names so 17 Chief Justices fit on the axis
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(
title = "U.S. Supreme Court",
subtitle = "Percent of decisions in a liberal direction, by Chief Justice",
x = "Chief Justice (in chronological order)",
y = "Percent of decisions",
caption = "Source: The Supreme Court Database")
# common mistake to watch for in OHs: if chief is still character (or was
# converted with plain factor()), the bars appear in ALPHABETICAL order
