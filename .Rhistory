survey <- tibble(
id        = 1:6,
edu_code  = c(3, 1, 5, 2, 4, 3),
edu_label = c("Bachelor's", "Less than HS", "Doctorate",
"High school", "Master's", "Bachelor's")
)
library(tidyverse)
survey <- tibble(
id        = 1:6,
edu_code  = c(3, 1, 5, 2, 4, 3),
edu_label = c("Bachelor's", "Less than HS", "Doctorate",
"High school", "Master's", "Bachelor's")
)
# Step 1: build a lookup table with each code next to its label, sorted by code
edu_lookup <- survey |>
distinct(edu_code, edu_label) |>
arrange(edu_code)
# Step 2: use its columns as levels and labels (no typing!)
survey <- survey |>
mutate(edu = factor(edu_code,
levels = pull(edu_lookup, edu_code),
labels = pull(edu_lookup, edu_label)))
levels(survey$edu)
survey <- tibble(
id        = 1:6,
edu_code  = c(3, 1, 5, 2, 4, 3),
edu_label = c("Bachelor", "Less than HS", "Doctorate",
"High school", "Master's", "Bachelor"))
survey
by code
