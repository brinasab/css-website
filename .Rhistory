library(tidyverse)
library(rcis)
data(scorecard)
scorecard_region <- scorecard |>
mutate(region = case_when(
state %in% northeast ~ "Northeast",
state %in% midwest   ~ "Midwest",
state %in% south     ~ "South",
state %in% west      ~ "West",
.default = "Territories"
))
count(scorecard_region, region)
scorecard_region |>
ggplot(aes(x = region, fill = type)) +
geom_bar(position = "fill") +
labs(
title = "Mix of college types by region",
x = "Region",
y = "Share of colleges",
fill = "College type"
)
# leave this as it is
knitr::opts_chunk$set(message = FALSE, warning = FALSE)
ggplot(scorecard, aes(x = type, fill = state)) +
geom_bar(position = "stack")
ggplot(scorecard, aes(x = type, fill = state)) +
geom_bar()
# your code here: count schools by state to check the raw data
scorecard %>%
count(state)
scorecard <- scorecard %>%
mutate(region = case_when(
state %in% c("CT", "ME", "MA", "NH", "RI", "VT", "NJ", "NY", "PA") ~ "Northeast",
state %in% c("IL", "IN", "IA", "KS", "MI", "MN", "MO", "NE", "ND", "OH", "SD", "WI") ~ "Midwest",
state %in% c("AL", "AR", "DE", "FL", "GA", "KY", "LA", "MD", "MS", "NC", "OK", "SC", "TN", "TX", "VA", "WV") ~ "South",
state %in% c("AK", "AZ", "CA", "CO", "HI", "ID", "MT", "NV", "NM", "OR", "UT", "WA", "WY") ~ "West"
))
scorecard %>% select(state, region)
# every state should have a region assigned, check for NAs
scorecard %>%
count(region, state) %>%
filter(is.na(region))
# overall check
scorecard %>%
count(region)
by_region <- scorecard %>%
count(region, state, type) %>%
group_by(region, type) %>%
summarize(total_by_region = sum(n))
by_region
by_region %>%
drop_na() %>%
ggplot(aes(x = region, y = total_by_region, fill = type)) +
geom_bar(stat = "identity", position = "stack") +
labs(
title = "Number of Schools by Region and Type",
x = "Region",
y = "Count",
fill = "School Type"
)
