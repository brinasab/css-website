df <- tibble(sex = c("MALE", "FEMALE", NA, "MALE"))
df
df <- df |>
mutate(is_male   = sex == "MALE",
is_female = sex == "FEMALE",
anything = TRUE)  # true for every row, does not check Sex!
df <- df |>
mutate(is_male   = sex == "MALE",
is_female = sex == "FEMALE",
anything = TRUE)  # true for every row, does not check Sex!
df
# only the MALE line
df |> mutate(new = case_when(Sex == "MALE" ~ 1))
# result: 1, NA, NA, 1
# only the MALE line
df |> mutate(new = case_when(sex == "MALE" ~ 1))
# result: 1, NA, NA, 1
df |> mutate(new = case_when(sex == "MALE" ~ 1,
sex == "FEMALE" ~ 0,
TRUE ~ -1))
df |> mutate(new = case_when(sex == "MALE" ~ 1,
sex == "FEMALE" ~ 0,
TRUE ~ NA))
